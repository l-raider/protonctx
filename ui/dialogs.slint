// Dialog windows. Each is its own OS window with server-side decorations,
// parented to the main window on X11 by the Rust side (`x11_dialog`). They
// share one chrome: padding, a body, and a right-aligned footer of outline
// buttons. Each dialog focuses its default button when it opens (Rust calls
// `focus-default` before showing it), so that button carries Qt's focus
// border. Esc dismisses; Tab moves the focus; Space or Enter activates the
// focused control, and Enter on a control that takes no Enter (the check box)
// activates the default button.

import { Theme } from "theme.slint";
import { Icon, OutlineButton, CheckBox, ScrollArea } from "widgets.slint";

// The keyboard and window frame shared by every dialog.
component DialogWindow inherits Window {
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    default-font-weight: Theme.font-weight;
    icon: @image-url("../packaging/icons/hicolor/256x256/apps/protonctx.png");

    // Esc (and the WM close button, from Rust).
    callback dismiss();
    // Enter that the focused control did not take.
    callback activate-default();

    // Never focused itself: it sees the keys the focused control passes up.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Return {
                root.activate-default();
                return accept;
            }
            reject
        }
        @children
    }
}

// Body copy at the theme size with Qt's 1.25 line height.
component BodyText inherits Text {
    color: Theme.foreground;
    wrap: word-wrap;
    // Qt's message boxes use 1.25 × the font size; Slint's factor scales
    // the font's own line height (about 1.36 × for Noto Sans).
    line-height-factor: 0.92;
    vertical-alignment: top;
}

// A dialog's message beside its icon. The dialogs have a fixed size, so a
// message taller than the room left (a host command's stderr, a long path,
// a large desktop font) scrolls, and the buttons stay in the window. A new
// message starts at its first line.
component DialogMessage inherits ScrollArea {
    in property <string> text;
    horizontal-stretch: 1;
    content-height: measure.preferred-height;

    public function scroll-to-top() {
        self.offset-y = 0;
    }
    changed text => {
        self.scroll-to-top();
    }

    BodyText {
        x: 0;
        y: 0;
        // The view beside the scroll bar, not the whole area.
        width: root.visible-width;
        height: self.preferred-height;
        text: root.text;
    }
    // The text's height at its width beside a scroll bar: with the bar shown
    // it is exact, and without it the text, wider, is no taller (measuring
    // the shown text would loop).
    measure := BodyText {
        visible: false;
        width: root.width - Theme.scrollbar-width;
        text: root.text;
    }
}

export component AboutDialog inherits DialogWindow {
    title: "About protonctx";
    width: 400px;
    // Taller when a large desktop font needs it, so the OK button stays in
    // the window.
    height: max(200px, body.preferred-height);
    in property <string> version;
    callback ok();
    forward-focus: ok-button;
    public function focus-default() {
        ok-button.focus();
    }
    dismiss => {
        root.ok();
    }
    activate-default => {
        root.ok();
    }

    body := VerticalLayout {
        padding: Theme.rem(4);
        spacing: Theme.rem(2);
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Theme.rem(2);
            HorizontalLayout {
                alignment: center;
                Image {
                    width: 64px;
                    height: 64px;
                    source: @image-url("../packaging/icons/hicolor/256x256/apps/protonctx.png");
                }
            }
            Text {
                text: root.version;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-alignment: center;
                line-height-factor: 0.92;
                color: Theme.foreground;
            }
            Text {
                text: "Launch executables inside a Steam game's Proton context.";
                wrap: word-wrap;
                horizontal-alignment: center;
                line-height-factor: 0.92;
                color: Theme.foreground;
            }
            Text {
                text: "Licensed under the GNU GPL v3.";
                wrap: word-wrap;
                horizontal-alignment: center;
                line-height-factor: 0.92;
                color: Theme.muted-foreground;
            }
        }
        HorizontalLayout {
            alignment: end;
            ok-button := OutlineButton {
                text: "OK";
                has-icon: true;
                icon: @image-url("../assets/icons/check.svg");
                clicked => {
                    root.ok();
                }
            }
        }
    }
}

export component SettingsDialog inherits DialogWindow {
    title: "Settings";
    width: 300px;
    height: 100px;
    in-out property <bool> remember-last-dir: true;
    callback remember-changed(bool);
    callback ok();
    forward-focus: ok-button;
    public function focus-default() {
        ok-button.focus();
    }
    dismiss => {
        root.ok();
    }
    activate-default => {
        root.ok();
    }

    VerticalLayout {
        padding: Theme.rem(4);
        spacing: Theme.rem(2);
        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            CheckBox {
                text: "Remember last used directory";
                checked <=> root.remember-last-dir;
                toggled(value) => {
                    root.remember-changed(value);
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            ok-button := OutlineButton {
                text: "OK";
                has-icon: true;
                icon: @image-url("../assets/icons/check.svg");
                clicked => {
                    root.ok();
                }
            }
        }
    }
}

export component ErrorDialog inherits DialogWindow {
    // What failed: the window title.
    in property <string> heading: "Launch Error";
    title: root.heading;
    width: 500px;
    height: 130px;
    in property <string> message;
    // How far the message is scrolled (read by the tests).
    out property <length> message-offset: -message-area.offset-y;
    callback ok();
    forward-focus: ok-button;
    // Called before every showing: a reused dialog opens at the top of its
    // message, as a new one does.
    public function focus-default() {
        message-area.scroll-to-top();
        ok-button.focus();
    }
    dismiss => {
        root.ok();
    }
    activate-default => {
        root.ok();
    }

    VerticalLayout {
        padding: Theme.rem(4);
        spacing: Theme.rem(2);
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.rem(5);
            // Qt's filled danger circle with a white cross.
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: start;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 28px;
                    background: Theme.danger;
                    Icon {
                        size: 32px;
                        source: @image-url("../assets/icons/x.svg");
                        colorize: white;
                    }
                }
            }
            message-area := DialogMessage {
                text: root.message;
            }
        }
        HorizontalLayout {
            alignment: end;
            ok-button := OutlineButton {
                text: "OK";
                has-icon: true;
                icon: @image-url("../assets/icons/check.svg");
                clicked => {
                    root.ok();
                }
            }
        }
    }
}

export component DeleteCacheDialog inherits DialogWindow {
    title: "Delete Shader Cache";
    width: 520px;
    height: 230px;
    in property <string> message;
    // While the deletion runs the buttons are disabled.
    in property <bool> deleting: false;
    // How far the message is scrolled (read by the tests).
    out property <length> message-offset: -message-area.offset-y;
    callback yes();
    callback no();
    // No is the default (the safe choice, as in Qt), and has the focus on
    // every open: Yes is only a Tab away, never a stale Enter.
    forward-focus: no-button;
    public function focus-default() {
        message-area.scroll-to-top();
        no-button.focus();
    }
    dismiss => {
        root.no();
    }
    activate-default => {
        root.no();
    }

    VerticalLayout {
        padding: Theme.rem(4);
        spacing: Theme.rem(2);
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.rem(3);
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: start;
                Icon {
                    size: 56px;
                    source: @image-url("../assets/icons/triangle-alert.svg");
                    colorize: Theme.warning;
                }
            }
            message-area := DialogMessage {
                text: root.message;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.rem(2);
            OutlineButton {
                text: "Yes";
                has-icon: true;
                icon: @image-url("../assets/icons/check.svg");
                enabled: !root.deleting;
                clicked => {
                    root.yes();
                }
            }
            no-button := OutlineButton {
                text: "No";
                has-icon: true;
                icon: @image-url("../assets/icons/ban.svg");
                enabled: !root.deleting;
                clicked => {
                    root.no();
                }
            }
        }
    }
}
