import { Button, HorizontalBox, ListView, Palette, ScrollView, VerticalBox } from "std-widgets.slint";

// Display-only row model, mirroring `models::Game` (subset of fields the UI needs).
export struct GameInfo {
    name: string,
    app-id: string,
    compat-tool: string,
}

// A built-in Wine tool shown as a button in the action bar.
export struct Tool {
    label: string,
    arg: string,
}

export component MainWindow inherits Window {
    title: "protonctx";
    // Window/taskbar icon (SVG), embedded in the binary via EmbedFiles.
    icon: @image-url("icon/icon.svg");

    // The installed games table, supplied from Rust.
    in-out property <[GameInfo]> games: [];

    // Built-in tool buttons, supplied from Rust.
    in property <[Tool]> tools: [];

    // Index of the selected row, or -1 when nothing is selected.
    in-out property <int> selected-index: -1;

    // Callbacks wired in Rust.
    callback select-game(int);
    callback browse-exe();
    callback launch-tool(string);
    callback show-settings();
    callback show-about();

    // Sizing: use preferred + min sizes (not fixed width/height) so the window is
    // resizable and exposes native maximize/minimize controls.
    preferred-width: 720px;
    preferred-height: 480px;
    min-width: 480px;
    min-height: 320px;

    MenuBar {
        Menu {
            title: "Settings";
            MenuItem {
                title: "Preferences…";
                activated => {
                    root.show-settings();
                }
            }
        }
        Menu {
            title: "About";
            MenuItem {
                title: "About protonctx";
                activated => {
                    root.show-about();
                }
            }
        }
    }

    VerticalBox {
        padding: 0px;

        // Column header row.
        HorizontalBox {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;

            header-name := Text {
                text: "Game";
                horizontal-stretch: 1;
                font-weight: 700;
            }
            header-id := Text {
                text: "App ID";
                width: 100px;
                font-weight: 700;
            }
            header-tool := Text {
                text: "Compatibility Tool";
                horizontal-stretch: 1;
                font-weight: 700;
            }
            // Spacer for the Select button column.
            Text {
                width: 90px;
            }
        }

        // Game rows.
        ScrollView {
            ListView {
                for game[idx] in root.games: Rectangle {
                    background: idx == root.selected-index ? Palette.accent-background.with-alpha(0.15) : Colors.transparent;

                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;

                        Text {
                            text: game.name;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: game.app-id;
                            width: 100px;
                        }
                        Text {
                            text: game.compat-tool;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Button {
                            text: "Select";
                            width: 90px;
                            clicked => {
                                root.select-game(idx);
                            }
                        }
                    }
                }
            }
        }

        // Action bar (enabled only when a game is selected).
        HorizontalBox {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: start;

            Button {
                text: "Browse…";
                enabled: root.selected-index >= 0;
                clicked => {
                    root.browse-exe();
                }
            }

            for tool in root.tools: Button {
                text: tool.label;
                enabled: root.selected-index >= 0;
                clicked => {
                    root.launch-tool(tool.arg);
                }
            }
        }
    }
}

// Settings dialog (placeholder for now; will be expanded later).
export component SettingsDialog inherits Dialog {
    title: "Settings";
    preferred-width: 360px;
    preferred-height: 180px;
    min-width: 360px;
    min-height: 180px;

    VerticalBox {
        padding: 16px;
        Text {
            text: "Nothing to configure yet.";
        }
        HorizontalBox {
            alignment: end;
            Button {
                text: "Close";
                clicked => {
                    root.hide();
                }
            }
        }
    }
}

// About dialog with version info.
export component AboutDialog inherits Dialog {
    title: "About protonctx";
    icon: @image-url("icon/icon.svg");
    in property <string> about-text: "";
    preferred-width: 380px;
    preferred-height: 200px;
    min-width: 380px;
    min-height: 200px;

    VerticalBox {
        padding: 16px;
        Text {
            text: root.about-text;
            wrap: word-wrap;
        }
        HorizontalBox {
            alignment: end;
            Button {
                text: "Close";
                clicked => {
                    root.hide();
                }
            }
        }
    }
}
