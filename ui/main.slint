import { Button, HorizontalBox, StandardTableView, VerticalBox } from "std-widgets.slint";

// Dialogs live in their own files for maintainability. Importing them keeps them
// part of the compiled UI and re-exported to Rust via include_modules!.
import { SettingsDialog } from "settings-dialog.slint";
import { AboutDialog } from "about-dialog.slint";
import { LaunchErrorDialog } from "launch-error-dialog.slint";

// Re-export the dialogs so the Rust code (slint::include_modules!) can construct them.
export { SettingsDialog, AboutDialog, LaunchErrorDialog }

// A built-in Wine tool shown as a button in the action bar.
export struct Tool {
    label: string,
    arg: string,
}

// Adapter global: keeps the (possibly sorted) list state and provides the pure sort
// callback used by the table. Implemented from Rust, so the rows are sorted in Rust
// and the table's current-row selection follows the sorted order automatically.
export global TableAdapter {
    in-out property <[[StandardListViewItem]]> rows: [];
    pure callback sort([[StandardListViewItem]], int, bool) -> [[StandardListViewItem]];
}

export component MainWindow inherits Window {
    title: "protonctx";
    // Window/taskbar icon (SVG), embedded in the binary via EmbedFiles.
    icon: @image-url("icon/icon.svg");

    // The installed games table columns + tool buttons, supplied from Rust
    // (the rows live in TableAdapter.rows, which the sort callback consumes).
    in property <[Tool]> tools: [];

    // The selected game: index into the *sorted* rows (the table's current-row),
    // or -1 when nothing is selected.
    in-out property <int> selected-index: -1;

    // Callbacks wired in Rust.
    callback browse-exe();
    callback launch-tool(string);
    callback show-settings();
    callback show-about();

    // Capture the table's sort requests and re-run them in Rust.
    property <int> sort-index: -1;
    property <bool> sort-ascending: true;

    // Sizing: use preferred + min sizes (not fixed width/height) so the window is
    // resizable and exposes native maximize/minimize controls.
    preferred-width: 720px;
    preferred-height: 480px;
    min-width: 480px;
    min-height: 320px;

    MenuBar {
        Menu {
            title: "Settings";
            MenuItem {
                title: "Preferences…";
                activated => {
                    root.show-settings();
                }
            }
        }
        Menu {
            title: "About";
            MenuItem {
                title: "About protonctx";
                activated => {
                    root.show-about();
                }
            }
        }
    }

    VerticalBox {
        padding: 0px;

        StandardTableView {
            // 3 data columns, all sortable. Selection happens by clicking a row
            // (current-row), so no dedicated Select button is needed.
            columns: [
                { title: "Game", horizontal-stretch: 1 },
                { title: "App ID" },
                { title: "Compatibility Tool", horizontal-stretch: 1 },
            ];
            rows: TableAdapter.sort(TableAdapter.rows, root.sort-index, root.sort-ascending);

            sort-ascending(index) => {
                root.sort-index = index;
                root.sort-ascending = true;
            }
            sort-descending(index) => {
                root.sort-index = index;
                root.sort-ascending = false;
            }

            current-row-changed(index) => {
                root.selected-index = index;
            }
            current-row <=> root.selected-index;
        }

        // Action bar (enabled only when a game is selected).
        HorizontalBox {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: start;

            Button {
                text: "Browse…";
                enabled: root.selected-index >= 0;
                clicked => {
                    root.browse-exe();
                }
            }

            for tool in root.tools: Button {
                text: tool.label;
                enabled: root.selected-index >= 0;
                clicked => {
                    root.launch-tool(tool.arg);
                }
            }
        }
    }
}
