// Shared Breeze-style building blocks. Every colour and metric comes from the
// `Theme` global; the mouse cursor stays the default arrow over buttons, as in
// Qt/KDE (TouchArea only changes it when asked).

import { Theme } from "theme.slint";

// A Lucide icon in the given colour.
export component Icon inherits Image {
    in property <length> size: Theme.font-size;
    width: self.size;
    height: self.size;
    image-fit: contain;
}

// The Breeze outline button of the action row and every dialog: 32 px high,
// at least 80 px wide, with an optional leading icon. `default-focus` paints
// the focus border Qt shows on a dialog's default button.
export component OutlineButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> default-focus: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    // Whole pixels so the 1 px outline lands on the pixel grid.
    property <length> natural: ceil((content.preferred-width + 30px) / 1px) * 1px;
    min-width: max(80px, self.natural);
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    height: 32px;

    property <bool> hot: root.enabled && (touch.has-hover || touch.pressed);

    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        background: !root.enabled
            ? Theme.input-background.transparentize(Theme.disabled-opacity)
            : touch.pressed ? Theme.accent : Theme.input-background;
        border-color: !root.enabled
            ? Theme.input-border.transparentize(Theme.disabled-opacity)
            : root.hot ? Theme.primary
            : root.default-focus ? Theme.ring : Theme.input-border;
    }

    content := HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if root.has-icon: Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: label.color;
        }
        label := Text {
            accessible-role: none;
            text: root.text;
            vertical-alignment: center;
            color: root.enabled
                ? Theme.button-foreground
                : Theme.muted-foreground.transparentize(Theme.disabled-opacity);
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The transparent toolbar button (hamburger and Refresh): gpui's medium ghost
// button, 2 rem high; hover, press, or `active` fill it with `primary`.
export component ToolbarButton {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <length> padding-x: 0px;
    // What assistive technology announces when the button shows no text.
    in property <string> name;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    height: Theme.rem(8);
    // `content` already includes `padding-x` on both sides.
    min-width: root.text == "" ? self.height : content.preferred-width;
    preferred-width: self.min-width;
    horizontal-stretch: 0;

    property <bool> hot: root.enabled && (touch.has-hover || touch.pressed || root.active);
    property <color> fg: !root.enabled
        ? Theme.foreground.transparentize(Theme.disabled-opacity)
        : root.hot ? Theme.primary-foreground : Theme.foreground;

    Rectangle {
        border-radius: Theme.radius;
        background: root.hot ? Theme.primary : transparent;
    }

    content := HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        alignment: center;
        spacing: Theme.rem(2);
        Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.fg;
        }
        if root.text != "": Text {
            accessible-role: none;
            // gpui's text_sm (0.875 rem) in whole pixels, as gpui renders it.
            font-size: round(Theme.font-size * 0.875 / 1px) * 1px;
            text: root.text;
            vertical-alignment: center;
            color: root.fg;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// One popup-menu item at the theme's base font size; hovering tints it with
// the selection and outlines it in the selection, as Breeze does.
export component MenuRow {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    // A key chord shown at the right edge, as Qt menus do.
    in property <string> shortcut;
    callback activated;

    height: 28px;

    // Slint 1.18 has no menu-item role; a button is the closest.
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.activated();
        }
    }

    property <bool> hot: root.enabled && touch.has-hover;
    Rectangle {
        border-radius: 3px;
        border-width: root.hot ? 1px : 0px;
        border-color: Theme.menu-hover-border;
        background: root.hot ? Theme.menu-hover : transparent;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: Theme.rem(1);
        if root.has-icon: Icon {
            size: Theme.font-size - 2px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: label.color;
        }
        label := Text {
            accessible-role: none;
            horizontal-stretch: 1;
            text: root.text;
            vertical-alignment: center;
            color: root.enabled
                ? Theme.menu-foreground
                : Theme.menu-foreground.transparentize(Theme.disabled-opacity);
        }
        if root.shortcut != "": Text {
            accessible-role: none;
            text: root.shortcut;
            vertical-alignment: center;
            color: label.color;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
    }
}

// A horizontal menu separator with breathing room above and below.
export component MenuSeparator {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

// The popup panel: KDE draws menus on the window fill, framed and rounded.
export component MenuPanel inherits Rectangle {
    background: Theme.menu-background;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;
}

// A Breeze scroll bar handle in its lane: the focus colour, faded while idle
// and hovered, opaque while dragged. The lane itself (fill and separator) is
// painted by `ScrollArea`. `offset` is the (negative) content offset of the
// scrolled view.
export component ScrollBar {
    in property <bool> horizontal: false;
    in property <length> visible-length;
    in property <length> content-length;
    in-out property <length> offset;

    property <length> track: root.horizontal ? root.width : root.height;
    property <length> max-offset: max(1px, root.content-length - root.visible-length);
    property <length> thumb: min(
        root.track,
        max(Theme.scrollbar-min-thumb, root.track * root.visible-length / max(1px, root.content-length)));
    property <length> thumb-start: (root.track - root.thumb) * (-root.offset / root.max-offset);
    property <length> grab;

    Rectangle {
        x: root.horizontal ? root.thumb-start : Theme.scrollbar-inset;
        y: root.horizontal ? Theme.scrollbar-inset : root.thumb-start;
        width: root.horizontal ? root.thumb : Theme.scroller-width;
        height: root.horizontal ? Theme.scroller-width : root.thumb;
        border-radius: Theme.scroller-width / 2;
        background: touch.pressed
            ? Theme.scrollbar-thumb-active
            : touch.has-hover ? Theme.scrollbar-thumb-hover : Theme.scrollbar-thumb;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.grab = -root.offset;
            }
        }
        moved => {
            if self.pressed {
                root.offset = -clamp(
                    root.grab
                        + (root.horizontal ? self.mouse-x - self.pressed-x : self.mouse-y - self.pressed-y)
                        * root.max-offset / max(1px, root.track - root.thumb),
                    0px,
                    root.content-length - root.visible-length);
            }
        }
    }
}

// A scrolled view whose scroll bars take their own lanes at the right and
// bottom edges while the content overflows, as Breeze's do: the view fill,
// a separator line against the content, and the handle.
export component ScrollArea {
    in property <length> content-width;
    in property <length> content-height;
    // The narrowest the content can get, for deciding whether the horizontal
    // lane is needed (the table stretches its last column to the view).
    in property <length> min-content-width: root.content-width;
    in-out property <length> offset-x <=> flick.content-x;
    in-out property <length> offset-y <=> flick.content-y;
    out property <length> visible-width: flick.width;
    out property <length> visible-height: flick.height;
    callback scrolled();

    property <length> lane: Theme.scrollbar-width;
    property <bool> fits-x: root.min-content-width <= root.width + 0.5px;
    property <bool> fits-y: root.content-height <= root.height + 0.5px;
    // One lane can push the other axis into overflow.
    out property <bool> overflow-y: !root.fits-y
        || (!root.fits-x && root.content-height > root.height - root.lane + 0.5px);
    out property <bool> overflow-x: !root.fits-x
        || (!root.fits-y && root.min-content-width > root.width - root.lane + 0.5px);

    flick := Flickable {
        x: 0;
        y: 0;
        // A mouse drag selects (log text) instead of panning, as in Qt views;
        // the wheel and touch still scroll.
        mouse-drag-pan-enabled: false;
        width: parent.width - (root.overflow-y ? root.lane : 0px);
        height: parent.height - (root.overflow-x ? root.lane : 0px);
        content-width: max(root.content-width, self.width);
        content-height: max(root.content-height, self.height);
        @children
    }

    // Keep the offsets inside the content when either size changes.
    public function clamp-offsets() {
        flick.content-x = clamp(flick.content-x, min(0px, flick.width - flick.content-width), 0px);
        flick.content-y = clamp(flick.content-y, min(0px, flick.height - flick.content-height), 0px);
    }

    // Scroll to the end of the content (a no-op before the first layout).
    public function scroll-to-bottom() {
        flick.content-y = min(0px, flick.height - flick.content-height);
    }

    changed visible-height => {
        root.clamp-offsets();
    }
    changed visible-width => {
        root.clamp-offsets();
    }
    changed content-height => {
        root.clamp-offsets();
    }
    changed content-width => {
        root.clamp-offsets();
    }

    // Wheel, flick, scroll bar drag, or a programmatic scroll.
    changed offset-y => {
        root.scrolled();
    }

    // The lanes, each separated from the content by a line along its whole
    // length (the lines cross in the corner).
    if root.overflow-y: Rectangle {
        x: parent.width - root.lane;
        y: 0;
        width: root.lane;
        height: parent.height;
        background: Theme.scrollbar-track;
    }
    if root.overflow-x: Rectangle {
        x: 0;
        y: parent.height - root.lane;
        width: parent.width;
        height: root.lane;
        background: Theme.scrollbar-track;
    }
    if root.overflow-y: Rectangle {
        x: parent.width - root.lane;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.scrollbar-separator;
    }
    if root.overflow-x: Rectangle {
        x: 0;
        y: parent.height - root.lane;
        width: parent.width;
        height: 1px;
        background: Theme.scrollbar-separator;
    }

    if root.overflow-y: ScrollBar {
        x: parent.width - root.lane;
        y: 0;
        width: root.lane;
        height: flick.height;
        visible-length: flick.height;
        content-length: flick.content-height;
        offset <=> flick.content-y;
    }

    if root.overflow-x: ScrollBar {
        horizontal: true;
        x: 0;
        y: parent.height - root.lane;
        width: flick.width;
        height: root.lane;
        visible-length: flick.width;
        content-length: flick.content-width;
        offset <=> flick.content-x;
    }
}

// The Breeze check box: a 1 rem box filled with `primary` and a check when
// checked; outlined like the buttons when not.
export component CheckBox {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);

    height: max(box.height, label.preferred-height);

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggle();
    }

    function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    box := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: round(Theme.font-size / 1px) * 1px;
        height: self.width;
        border-radius: Theme.radius - 1px;
        border-width: 1px;
        background: root.checked ? Theme.primary : Theme.input-background;
        border-color: root.checked || touch.has-hover ? Theme.primary : Theme.input-border;
        if root.checked: Icon {
            size: parent.width - 2px;
            source: @image-url("../assets/icons/check.svg");
            colorize: Theme.primary-foreground;
        }
    }

    label := Text {
        accessible-role: none;
        x: box.width + Theme.rem(2);
        // gpui's checkbox label is text_sm (0.875 rem).
        font-size: Theme.font-size * 0.875;
        text: root.text;
        vertical-alignment: center;
        color: Theme.foreground;
    }

    touch := TouchArea {
        clicked => {
            root.toggle();
        }
    }
}
