# Build environment for producing protonctx .deb packages.
#
# Deliberately based on Debian 13 (trixie) so the binary links against the
# OLDEST glibc the .deb must support (Debian 13 / Ubuntu 26.04). Building
# on the Fedora 44 host instead would emit binaries requiring a newer glibc
# that older distros cannot satisfy. The `depends = "$auto"` in Cargo.toml
# also relies on `dpkg-shlibdeps` to resolve the runtime library dependencies,
# which needs a Debian/Ubuntu host to produce a populated `Depends:` field —
# another reason to build inside Debian 13.
FROM debian:13

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates build-essential pkg-config cmake \
    file git \
    libxkbcommon-dev libxkbcommon-x11-dev libwayland-dev libx11-dev \
    libfontconfig1-dev libssl-dev \
    librsvg2-bin \
    dpkg-dev \
  && rm -rf /var/lib/apt/lists/*

# Rust stable (edition 2024 requires 1.85+; Cargo.toml requires 1.95+).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# cargo-deb: emits the .deb from [package.metadata.deb] in Cargo.toml.
RUN cargo install cargo-deb

WORKDIR /src
